# ═══════════════════════════════════════════════════════════════════════════════
# Wealth Management System — environment configuration
#
# Copy the two sections below into their own files:
#   backend/.env    ← everything under [BACKEND]
#   frontend/.env   ← everything under [FRONTEND]
#
# Never commit the filled-in files. Only this example belongs in git.
# ═══════════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────────
# [BACKEND]  →  backend/.env
# ───────────────────────────────────────────────────────────────────────────────

# ── Database (required) ────────────────────────────────────────────────────────
# PostgreSQL 15+ with the pgvector extension enabled. Supabase provides both.
#
# Supabase → Project Settings → Database → Connection string:
#   * DATABASE_URL uses the pooled connection (port 6543) for the running app.
#   * DIRECT_URL uses the direct connection (port 5432) — Prisma Migrate needs
#     it because migrations cannot run through the transaction pooler.
#   Enable pgvector once per project:  create extension if not exists vector;
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local Docker alternative (docker compose up -d in backend/):
# DATABASE_URL="postgresql://postgres:dev@localhost:5432/weallth?schema=public"
# DIRECT_URL="postgresql://postgres:dev@localhost:5432/weallth?schema=public"

# ── Authentication (required) ──────────────────────────────────────────────────
# Signing key for the 7-day session JWT. Use a long random string in any
# environment that is not a local machine.
JWT_SECRET="replace-with-a-long-random-secret"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
# Restrict browser origins in production, e.g. https://app.example.com
# CORS_ORIGIN="http://localhost:5173"

# ── AI: wealth advisor (RAG over the financial-planning knowledge base) ────────
# Google Gemini powers embeddings and long-form advisory answers.
# Without it, the AI advisor, goal coach and recommendation explanations are
# unavailable; every other feature still works.
GEMINI_API_KEY=""
EMBEDDING_MODEL_NAME="gemini-embedding-001"
EMBEDDING_DIMENSION=768

# ── AI: fast LLM (AI CFO, Risk Radar, Treasury, Smart Reports) ────────────────
# GroqCloud key (gsk_...) or xAI key (xai-...). One key serves both the RAG
# engine's fast path and the markets modules.
# Without it, those screens fall back to their built-in deterministic analysis.
GROQ_API_KEY=""
GROQ_MODEL_NAME="llama-3.3-70b-versatile"
FAST_LLM_TIMEOUT_MS=30000

# Legacy aliases, still honoured if GROQ_* are unset:
# GROK_API_KEY=""
# GROK_MODEL_NAME="llama-3.3-70b-versatile"
GROK_TIMEOUT_MS=4000

# ── External data: market quotes, news and report benchmarks ──────────────────
# Serper.dev key. Without it, Market Pulse and Smart Reports serve their
# built-in reference dataset instead of live data.
SERPER_API_KEY=""

# ── Retrieval tuning (pgvector hybrid search) ─────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.55
RETRIEVAL_HYBRID_VECTOR_WEIGHT=0.7
RETRIEVAL_HYBRID_KEYWORD_WEIGHT=0.3
RETRIEVAL_RRF_K=60
RETRIEVAL_ENABLE_RERANKING=false
RETRIEVAL_ENABLE_ADJACENT_CHUNKS=false
RETRIEVAL_ENABLE_CACHE=true
RETRIEVAL_CACHE_TTL_SECONDS=600

# ── LLM response cache ────────────────────────────────────────────────────────
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=600


# ───────────────────────────────────────────────────────────────────────────────
# [FRONTEND]  →  frontend/.env
#
# Vite exposes VITE_* variables to the browser. Never put a secret here.
# ───────────────────────────────────────────────────────────────────────────────

# Google Maps JavaScript API key for the Branch Intelligence map.
# Without it the branch metrics still render; only the map is replaced with a
# short notice. Restrict the key by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=""

# Backend origin for the dev-server proxy. Defaults to http://localhost:3001.
# VITE_API_PROXY_TARGET="http://localhost:3001"
