{
  "name": "wealth-management-system-backend",
  "version": "1.0.0",
  "description": "Wealth Management System — API service (wealth planning, research and markets)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "export:embeddings": "ts-node src/services/rag/exportEmbeddings.ts",
    "export:text": "ts-node src/services/rag/exportExtractedText.ts",
    "rag:pipeline": "python3 src/services/rag/pipeline/build_rag_knowledge.py --pdf \"../../Weallth/Discover The Wealth Within You/Ric Edelman - Discover the Wealth Within You_ A Financial Plan For Creating a Rich and Fulfilling Life-HarperCollins (2010).pdf\" --out-dir src/services/rag/rag_out",
    "rag:ingest": "ts-node src/services/rag/cli.ts ingest",
    "rag:eval": "ts-node src/services/rag/eval_retrieval.ts",
    "rag:build": "npm run rag:pipeline && npm run rag:ingest",
    "test": "vitest run src",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.4.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
